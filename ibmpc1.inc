;* IBMPC1 8x8 Character Set Macros
;*
;* Initials: JF = Jeff Frohwein
;*
;* Rev 1.0 - 21-Jul-97 : Original release of first 128 chars - JF
;* Rev 1.1 - 27-Jul-97 : Modified for new subroutine prefixes - JF
;* Rev 1.2 - 15-Mar-98 : All 256 chars now supported - JF
;* Rev 1.3 - 15-Mar-98 : E9 & EA chars had extra rows. Now fixed. - JF
;* 2026: Modified to work with modern rgbasm... - Jered
;*
;* Library Macros:
;*
;* chr_IBMPC1 -
;*   Insert IBMPC fonts into code.
;*
;*  This macro allows you to insert parts or the whole
;* character set into your code. Parameters: 1=$00-$1f,
;* 2=$20-$3f, 3=$40-$5f, 4=$60-7f, 5=$80-9f, 6=$a0-bf,
;* 7=$c0-df, and 8=$e0-ff. Examples:
;*
;*     chr_IBMPC1 1,8      - Insert chars $00 - $ff.
;*     chr_IBMPC1 2,2      - Insert chars $20 - $3f.
;*

MACRO DR
        db    \1
        db    \1
ENDM

MACRO chr_IBMPC1

        IF      (\1 == 0) || (\2 == 0) || (\1 > \2) || (\2 > 8)
        FAIL    "Font range values are invalid"
